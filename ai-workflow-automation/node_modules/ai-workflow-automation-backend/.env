# Backend .env Configuration

# Server
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database - MongoDB
DB_HOST=localhost
DB_PORT=27017
DB_NAME=workflow_automation
DB_USERNAME=
DB_PASSWORD=
MONGODB_URI=mongodb://localhost:27017/workflow_automation

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Features
ENABLE_EMAIL_VERIFICATION=false
ENABLE_API_KEY_AUTH=false

# External Services
SLACK_API_TOKEN=
GITHUB_API_TOKEN=
OPENAI_API_KEY=

# Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@workflowpro.com

# Logging
LOG_FORMAT=json
